    "csv-stringify": "6.9.0",
    "discord.js": "14.27.0",
    "dotenv": "18.0.8",
    "hono": "4.13.13",
    "htmlparser2": "12.0.0",
    "openai": "7.38.0",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
