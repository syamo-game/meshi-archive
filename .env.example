# Local SQLite; use a PostgreSQL URL when running with PostgreSQL.
DATABASE_URL=sqlite:///./meshi.db

# Web
APP_ENV=development
ALLOW_ANONYMOUS_READ=false
# Production requires the exact reverse proxy IP; never use a wildcard.
FORWARDED_ALLOW_IPS=127.0.0.1
WEB_PASSWORD=
ADMIN_PASSWORD=
SECRET_KEY=
APP_READ_ONLY=false
HTTPS_ONLY=false

# Discord Bot and OpenAI
DISCORD_TOKEN=
OPENAI_API_KEY=
ADMIN_USER_ID=
EXTRACTION_MODEL=gpt-5.6-luna
RESOLUTION_MODEL=gpt-5.6-terra
WEB_SEARCH_USD_PER_1K_CALLS=10
AI_MAX_CONCURRENCY=2
SYNC_BATCH_LIMIT=500

# Discord links and OAuth
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback
DISCORD_ALLOWED_USER_IDS=
